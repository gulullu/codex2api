[Unit]
Description=Reconcile codex-pro failover every 10 seconds
Documentation=file:/usr/local/share/doc/codex2api-sub2-codex-pro-failover/README.md

[Timer]
OnBootSec=10s
OnUnitInactiveSec=10s
Persistent=true
RandomizedDelaySec=0
AccuracySec=1s
Unit=codex2api-sub2-codex-pro-failover.service

[Install]
WantedBy=timers.target
