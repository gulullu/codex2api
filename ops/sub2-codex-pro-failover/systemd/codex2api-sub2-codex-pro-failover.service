[Unit]
Description=Codex2API to sub2api codex-pro failover controller
Documentation=file:/usr/local/share/doc/codex2api-sub2-codex-pro-failover/README.md
Requisite=docker.service
After=docker.service network-online.target
AssertPathExists=/var/run/docker.sock

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/default/codex2api-sub2-codex-pro-failover
Environment=HEALTH_URL=http://127.0.0.1:8090/health
Environment=SUB2_ADMIN_BASE_URL=http://127.0.0.1:18082
Environment=GROUP_NAME=codex-pro
Environment=BACKUP_OPEN_PARALLELISM=4
Environment=SUB2_ADMIN_REQUEST_TIMEOUT_SECONDS=5
Environment=BACKUP_OPEN_BATCH_TIMEOUT_SECONDS=120
Environment=RECOVERY_CONFIRMATIONS=3
Environment=FAILOVER_MIN_HOLD_SECONDS=180
Environment=RECOVERY_CLEAN_SECONDS=120
Environment=RECOVERY_RELAY_SUCCESSES=20
Environment=ROUTE_UNAVAILABLE_WINDOW_SECONDS=15
Environment=ROUTE_UNAVAILABLE_DETECTION_SECONDS=60
Environment=ROUTE_UNAVAILABLE_THRESHOLD=2
Environment=ROUTE_UNAVAILABLE_SPARSE_THRESHOLD=3
Environment=RELAY_AVAILABILITY_WINDOW_SECONDS=15
Environment=RELAY_AVAILABILITY_DETECTION_SECONDS=60
Environment=RELAY_AVAILABILITY_THRESHOLD=2
Environment=TELEMETRY_FAILURE_CONFIRMATIONS=2
Environment=DOCKER_CONFIG=/run/codex2api-sub2-codex-pro-failover
LoadCredential=sub2api_admin_key:/root/.sub2api_admin.key
StateDirectory=codex2api-sub2-codex-pro-failover
StateDirectoryMode=0700
RuntimeDirectory=codex2api-sub2-codex-pro-failover
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/timeout --signal=TERM --kill-after=5s 175s /usr/local/libexec/codex2api-sub2-codex-pro-failover reconcile
TimeoutStartSec=180s
TimeoutStopSec=5s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex2api-sub2-codex-pro-failover
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
